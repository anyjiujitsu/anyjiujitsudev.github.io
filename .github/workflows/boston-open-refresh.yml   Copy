name: Boston Open IBJJF roster refresh
on:
  workflow_dispatch:
  schedule:
    - cron: '17 12 * * *'
permissions:
  contents: write
jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install requests beautifulsoup4
      - name: Refresh the Boston competition athlete rosters
        run: |
          SCRIPT=$(find . -path "*/bostonopen/refresh_ibjjf.py" -not -path "*/.git/*" -print -quit)
          test -n "$SCRIPT" || { echo "Boston Open refresh script not found"; exit 1; }
          python "$SCRIPT"
      - name: Save updated data
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add "$(find . -path "*/bostonopen/athletes.json" -not -path "*/.git/*" -print -quit)"
          if ! git diff --cached --quiet; then
            git commit -m 'Refresh Boston Open IBJJF athlete rosters'
            git push
          fi
