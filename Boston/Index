<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Boston Open | ANY N.E. GRAPPLING</title>
  <!-- Reuse the existing site assets. No edits to shared files required. -->
  <link rel="stylesheet" href="../assets/css/tokens.css" />
  <link rel="stylesheet" href="../assets/css/base.css" />
  <link rel="stylesheet" href="../assets/css/layout.css" />
  <link rel="stylesheet" href="../assets/css/pills.css" />
  <link rel="stylesheet" href="../assets/css/components.css" />
  <link rel="stylesheet" href="../assets/css/directory.css" />
  <style>
    /* Only styles specific to the Boston Open page. */
    .boston-header-row { align-items: flex-end; }
    .boston-home { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; color:var(--icon); margin-left:auto; text-decoration:none; }
    .boston-home svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
    .boston-home:hover { opacity:.65; }
    .boston-filter-strip { min-height:60px; }
    .boston-content { min-height:55vh; }
    .boston-heading { display:none; } /* Content area intentionally reserved for future sections. */
    @media (max-width:430px) {
      .boston-home { width:24px; height:24px; }
      .boston-home svg { width:17px; height:17px; }
      .boston-filter-strip { min-height:40px; }
    }
  </style>
</head>
<body>
  <div class="app" id="app">
    <header class="header" id="header">
      <div class="siteLogoRow" aria-label="ANY logo">
        <div class="header__inner siteHeaderInner--logo">
          <div class="header__logoCrop"><img class="header__logoImage" src="../logo.png" alt="ANY" /></div>
        </div>
      </div>
      <div class="header__inner siteHeaderInner--title boston-header-row">
        <h1 class="header__title">BOSTON OPEN</h1>
        <a class="boston-home" href="../" aria-label="Back to Events and Index" title="Home">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9"/><path d="M9 21v-8h6v8"/></svg>
        </a>
      </div>
      <div class="stickyFilters">
        <nav class="filters" aria-label="Boston Open page toolbar">
          <div class="filters__inner boston-filter-strip"></div>
        </nav>
      </div>
    </header>
    <main class="content boston-content" aria-label="Boston Open">
      <div class="content__inner" id="bostonOpenRoot">
        <!-- Boston Open content will be added here. -->
      </div>
    </main>
  </div>
</body>
</html>
